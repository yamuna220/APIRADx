# Application
APP_NAME=APIRADx
APP_VERSION=1.0.0
DEBUG=False

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apiradx

# Security
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:8443"]

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS={".yaml", ".yml", ".json"}

# SMTP Email Configuration
# For Gmail SMTP:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM=noreply@apiradx.com
SMTP_FROM_NAME=APIRADx
SMTP_TLS=True
SMTP_SSL=False

# For Mailtrap (development/testing):
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USERNAME=your-mailtrap-username
# SMTP_PASSWORD=your-mailtrap-password
# SMTP_FROM=noreply@apiradx.com
# SMTP_FROM_NAME=APIRADx
# SMTP_TLS=False
# SMTP_SSL=False

# Email Verification
VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Password Reset
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Frontend URL for email links
FRONTEND_URL=http://localhost:8443

# AI Provider (for future OpenAI/Claude integration)
AI_PROVIDER=mock
OPENAI_API_KEY=
