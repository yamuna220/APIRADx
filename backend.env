# Database
DATABASE_URL=sqlite:///./apiradx.db

# Security
SECRET_KEY=your-secret-key-change-in-production-use-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:8443,http://localhost:5173

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=yaml,yml,json

# AI Provider
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# SMTP Email Configuration (Optional - for development, emails will be logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@apiradx.com
SMTP_FROM_NAME=APIRADx
SMTP_TLS=True
SMTP_SSL=False

# Token Expiration
VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Frontend URL
FRONTEND_URL=http://localhost:8443
